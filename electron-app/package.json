{
  "name": "vibeconferencing-agent",
  "productName": "Vibeconferencing",
  "version": "0.8.18",
  "description": "AI agents as real participants in your video calls",
  "homepage": "https://github.com/wanderingstan/vibeconf-app",
  "author": "Stan James <stan@wanderingstan.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dev-with-tools": "electron . --devtools=true",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:fast": "electron-builder -c.mac.notarize=false",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "reset-perms": "tccutil reset All com.vibeconferencing.agent"
  },
  "build": {
    "beforePack": "./before-pack.js",
    "appId": "com.vibeconferencing.agent",
    "publish": [
      {
        "provider": "github",
        "owner": "wanderingstan",
        "repo": "vibeconf-app"
      }
    ],
    "productName": "Vibeconferencing",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Vibeconferencing needs microphone access to enable bot audio in Google Meet calls.",
        "NSCameraUsageDescription": "Vibeconferencing needs camera access to display the bot's virtual camera in Google Meet calls."
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "AudioVideo",
      "maintainer": "Stan James <stan@wanderingstan.com>",
      "synopsis": "AI agents as real participants in your video calls"
    },
    "files": [
      "*.js",
      "*.mp3",
      "sounds/**/*",
      "renderer/**/*",
      "ack/**/*",
      "prompts/**/*",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../mcp-server",
        "to": "mcp-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "emoji",
        "to": "emoji",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
