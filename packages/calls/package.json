{
  "name": "@vibeconferencing/calls",
  "version": "0.0.0",
  "private": true,
  "description": "Join, speak, hear, chat and screen share in Meet, Zoom, Teams, Slack huddles, WhatsApp, Telegram and phone calls, as a participant",
  "license": "MIT",
  "author": "Stan James <stan@wanderingstan.com>",
  "homepage": "https://github.com/wanderingstan/vibeconf-app",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./hosts/playwright": {
      "types": "./hosts/playwright/index.d.ts",
      "default": "./hosts/playwright/index.js"
    },
    "./hosts/electron": {
      "types": "./hosts/electron/index.d.ts",
      "default": "./hosts/electron/index.js"
    },
    "./conformance": "./conformance/suite.js",
    "./package.json": "./package.json",
    "./core/*.js": "./core/*.js",
    "./core/*": "./core/*.js",
    "./providers/*.js": "./providers/*.js",
    "./providers/*": "./providers/*.js",
    "./hearing/*.js": "./hearing/*.js",
    "./hearing/*": "./hearing/*.js",
    "./inject/*.js": "./inject/*.js",
    "./inject/*": "./inject/*.js",
    "./recording/*.js": "./recording/*.js",
    "./recording/*": "./recording/*.js",
    "./hosts/electron/*.js": "./hosts/electron/*.js",
    "./hosts/electron/*": "./hosts/electron/*.js",
    "./hosts/electron/*.html": "./hosts/electron/*.html"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "api/",
    "examples/",
    "core/",
    "providers/",
    "inject/",
    "hearing/",
    "recording/",
    "hosts/",
    "conformance/",
    "docs/",
    "scripts/"
  ],
  "peerDependencies": {
    "electron": ">=33",
    "ffmpeg-static": "^5.2.0",
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "1.64.1"
  }
}
