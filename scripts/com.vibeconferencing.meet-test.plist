<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the scheduled automated Meet test (Stan's Mac mini).
  Install: see scripts/SCHEDULING.md. Runs the wrapper nightly at 03:00 in the
  logged-in GUI session (required for Electron + mic/cam/screen perms). Invoked
  via `zsh -lc` so it inherits the user's full PATH (node/pnpm).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vibeconferencing.meet-test</string>

  <!-- Recording knobs the wrapper reads:
       VIBECONF_RECORD       — screen-record each live-call lane (.mov).
       VIBECONF_RECORD_CALLS — turn on the app's PER-PARTICIPANT call recording for
                               every test bot (each records its own audio+video to
                               <profile>/agent/calls/<id>/call-recording*.mp4).
       VIBECONF_RECORD_KEEP  — retention for BOTH the .mov and the harvested call
                               recordings. `nightly` keeps EVERY lane's recording for
                               the current run, then reaps the prior run's GREENS at
                               the next run's start while keeping its FAILURES — so
                               last night's lanes are all inspectable for a day and
                               only failures persist. (`fails` = only failures kept;
                               `all` = everything kept.) Newest VIBECONF_RECORD_MAX
                               (default 5) kept per kind. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>VIBECONF_RECORD</key>
    <string>1</string>
    <key>VIBECONF_RECORD_CALLS</key>
    <string>1</string>
    <key>VIBECONF_RECORD_KEEP</key>
    <string>nightly</string>

    <!-- The Linux lane's target box (#329/#367). It lives HERE, not in a shell
         profile, for two reasons.

         It is a property of THIS SCHEDULE, not of the machine: which box the
         3am job is allowed to wipe is a fact about the job.

         And a shell profile would not reliably reach it anyway. ProgramArguments
         runs `zsh -lc`, and ~/.zshrc is sourced only for INTERACTIVE shells —
         the same trap CLAUDE.md documents for APPLE_ID, where notarization
         silently skipped because the creds were in .zshrc and the LaunchAgent
         could not see them.

         MUST be a disposable TEST box. The lane git-reset --hards the clone,
         tmux kill-servers, pkills the app and rewrites app-level preferences.
         Pointed at the cloud-TA box it would kill an instructor's live agent
         mid-session, nightly. The lane refuses to run if this is unset rather
         than guessing. -->
    <key>VIBECONF_TEST_INSTANCE</key>
    <string>i-0eee9f56a7ef905cc</string>

    <!-- Route the nightly digest to Stan's DM instead of the big Seth/Coltrane
         group. notify-nightly.mjs defaults CHAT to -5140242529 (that group) when
         unset; 6785998012 is Stan's DM chat_id — VERIFIED delivering (test send
         2026-08-15). NB: 8658687776 was tried and 403s ("bot can't message a bot"),
         so it is NOT a usable target.

         This block lived ONLY in the installed ~/Library/LaunchAgents copy until
         2026-08-19 and was missing here — so the `cp` in SCHEDULING.md's install
         steps would silently have reverted the digest to the group. Kept in the
         repo copy now so the documented install is safe to re-run. -->
    <key>VIBECONF_NOTIFY_CHAT</key>
    <string>6785998012</string>

    <!-- The account the rig's vibeconferencing.com session MUST belong to
         (ecosystem-preflight.mjs). Without it the preflight only REPORTS which
         account the session carries; with it, the wrong account is a red line.

         Not hypothetical. On 2026-09-01 a re-mint of the rig session produced a
         valid, year-long token for the OPERATOR'S PERSONAL Google account rather
         than the bot's. Every check passed — the site accepted it, /api/auth/me
         said authenticated:true — and the rig would have gone on minting rooms
         owned by a human, landing in their room history, looking entirely
         healthy. A session can be perfectly valid and still be the wrong one.

         Lives here rather than defaulted in the script because vibeconf-app is a
         public repo and hardcoding an account into it is worse than the check is
         good. Same reasoning as VIBECONF_TEST_INSTANCE above: it is a property of
         THIS schedule, not of the machine. -->
    <key>VIBECONF_EXPECT_ACCOUNT</key>
    <string>jimmy@spiritprotocol.io</string>

    <!-- Global watchdog, in seconds (scheduled-meet-test.sh defaults to 1800).
         Raised to 40 min on 2026-08-19.

         A run's cost is dominated by FAILING lanes, not by lane count: a failure
         adds retries, multi-second timeouts, and a 250-390MB .mov to keep and
         upload. The 08-17 run passed everything and finished the WHOLE suite in
         13m14s; the 08-19 run failed five lanes and spent 23m24s just getting
         through whiteboard-e2e. At 1800s that left ~3 min for codex + linux
         (~2m and ~1m50s respectively) — enough on paper, nothing to spare.

         Deliberately raised only AFTER the lane order was fixed. On its own a
         bigger timeout just lets a growing suite keep hiding whichever lane is
         last, which is how the Linux lane went missing for three nights; with
         the experimental fuzz lane now running last, the lane this protects is
         the one we are willing to lose. Still bounded, because the watchdog
         exists to stop a wedged run from skipping the NEXT night (#2026-07-21,
         when one hung run silently ate four nightlies). -->
    <key>VIBECONF_GLOBAL_TIMEOUT</key>
    <!-- 90 min. Was 2400 (40). Raised 2026-08-24: the mini has the whole night
         and nothing else to do, and the suite is growing lanes. The watchdog is
         a wedge-breaker, not a budget — see the lane-ORDER note in
         scheduled-meet-test.sh: a bigger number does NOT excuse letting a slow
         lane hide the ones behind it, which is how the Linux lane went missing
         for three nights. Keep cheap deterministic lanes first. -->
    <string>5400</string>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>/Users/wanderingstan/Developer/vibeconf-app/scripts/scheduled-meet-test.sh</string>
  </array>

  <!-- Nightly at 03:00. Edit Hour/Minute to taste; add more <dict> entries to
       this array for multiple times per day. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>3</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- launchd's own stdout/err (the wrapper also writes its own timestamped log
       under ~/vibeconf-test-results/). -->
  <key>StandardOutPath</key>
  <string>/Users/wanderingstan/vibeconf-test-results/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/wanderingstan/vibeconf-test-results/launchd.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
